# Copy to .env and fill in. The pipeline reads these via simpero.config.

# PostgreSQL connection (matches docker-compose.yml defaults).
DATABASE_URL=postgresql+psycopg://simpero:simpero@localhost:5432/simpero

# Anthropic API key. If UNSET, the seed script runs with the deterministic
# offline mock LLM so the full pipeline works with zero external calls.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are pinned in simpero/config.py).
# SIMPERO_HAIKU_MODEL=claude-haiku-4-5-20251001
# SIMPERO_SONNET_MODEL=claude-sonnet-4-6
