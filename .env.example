# Copy to .env and fill in. The pipeline reads these via dealintel.config.

# PostgreSQL connection (matches docker-compose.yml defaults).
DATABASE_URL=postgresql+psycopg://dealintel:dealintel@localhost:5432/dealintel

# Anthropic API key. If UNSET, the seed script runs with the deterministic
# offline mock LLM so the full pipeline works with zero external calls.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are pinned in dealintel/config.py).
# DEALINTEL_HAIKU_MODEL=claude-haiku-4-5-20251001
# DEALINTEL_SONNET_MODEL=claude-sonnet-4-6
